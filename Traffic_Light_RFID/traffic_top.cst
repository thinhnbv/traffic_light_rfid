// =============================================================================
// Physical Constraints File (.cst)
// Target Device: GW5A-LV25MG121
// Board: Xiaomeige ACG525 Domestic Gowin FPGA Development Board
// =============================================================================

// ─── Clock & Reset ───
IO_LOC "clk_osc" T9;            // CLK_G (50MHz Oscillator)
IO_PORT "clk_osc" IO_TYPE=LVCMOS33;

IO_LOC "rst_btn_n" B16;         // KEY0 (Active-low onboard key)
IO_PORT "rst_btn_n" IO_TYPE=LVCMOS33;

// ─── DIP Switch / Cấu hình Node ID (Sử dụng KEY1 và KEY2 onboard làm cấu hình tạm hoặc cắm dây)
IO_LOC "node_id[0]" A15;        // KEY1 onboard
IO_PORT "node_id[0]" IO_TYPE=LVCMOS33;
IO_LOC "node_id[1]" C15;        // KEY2 onboard
IO_PORT "node_id[1]" IO_TYPE=LVCMOS33;

// ─── LED Chỉ Báo Đèn Giao Thông (Sử dụng kết hợp LED onboard và GPIO) ───
// Trục Bắc - Nam (North-South)
IO_LOC "led_ns[2]" D14;        // LED0 onboard -> Đỏ NS
IO_PORT "led_ns[2]" IO_TYPE=LVCMOS33;
IO_LOC "led_ns[1]" C17;        // GPIO0 (Pin 1 trên Header 40-pin) -> Vàng NS
IO_PORT "led_ns[1]" IO_TYPE=LVCMOS33;
IO_LOC "led_ns[0]" C14;        // LED1 onboard -> Xanh NS
IO_PORT "led_ns[0]" IO_TYPE=LVCMOS33;

// Trục Đông - Tây (East-West)
IO_LOC "led_ew[2]" B9;         // LED2 onboard -> Đỏ EW
IO_PORT "led_ew[2]" IO_TYPE=LVCMOS33;
IO_LOC "led_ew[1]" C18;        // GPIO1 (Pin 2 trên Header 40-pin) -> Vàng EW
IO_PORT "led_ew[1]" IO_TYPE=LVCMOS33;
IO_LOC "led_ew[0]" A9;         // LED3 onboard -> Xanh EW
IO_PORT "led_ew[0]" IO_TYPE=LVCMOS33;

// Đèn báo hiệu trạng thái ưu tiên preemption
IO_LOC "led_prio" F14;         // GPIO2 (Pin 3 trên Header 40-pin) -> LED Priority
IO_PORT "led_prio" IO_TYPE=LVCMOS33;

// ─── Bus SPI Kết Nối 4 Đầu Đọc RC522 (Cắm qua Header GPIO) ───
IO_LOC "spi_sck" G14;          // GPIO3 (Pin 4) -> SPI_SCK chung
IO_PORT "spi_sck" IO_TYPE=LVCMOS33;
IO_LOC "spi_mosi" D17;         // GPIO4 (Pin 5) -> SPI_MOSI chung
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_LOC "spi_miso" D18;         // GPIO5 (Pin 6) -> SPI_MISO chung
IO_PORT "spi_miso" IO_TYPE=LVCMOS33;

IO_LOC "cs_n[3]" G16;          // GPIO6 (Pin 7) -> SDA (CS) Reader North
IO_PORT "cs_n[3]" IO_TYPE=LVCMOS33;
IO_LOC "cs_n[2]" G18;          // GPIO7 (Pin 8) -> SDA (CS) Reader South
IO_PORT "cs_n[2]" IO_TYPE=LVCMOS33;
IO_LOC "cs_n[1]" F17;          // GPIO8 (Pin 9) -> SDA (CS) Reader East
IO_PORT "cs_n[1]" IO_TYPE=LVCMOS33;
IO_LOC "cs_n[0]" F18;          // GPIO9 (Pin 10) -> SDA (CS) Reader West
IO_PORT "cs_n[0]" IO_TYPE=LVCMOS33;

// ─── Cổng Kết Nối RS485 LEFT (Header GPIO) ───
IO_LOC "left_rx" H13;          // GPIO10 (Pin 11) -> RO của MAX485 LEFT
IO_PORT "left_rx" IO_TYPE=LVCMOS33;
IO_LOC "left_tx" H14;          // GPIO11 (Pin 12) -> DI của MAX485 LEFT
IO_PORT "left_tx" IO_TYPE=LVCMOS33;
IO_LOC "left_de" K15;          // GPIO12 (Pin 13) -> DE/RE_N của MAX485 LEFT
IO_PORT "left_de" IO_TYPE=LVCMOS33;

// ─── Cổng Kết Nối RS485 RIGHT (Header GPIO) ───
IO_LOC "right_rx" K16;         // GPIO13 (Pin 14) -> RO của MAX485 RIGHT
IO_PORT "right_rx" IO_TYPE=LVCMOS33;
IO_LOC "right_tx" J13;         // GPIO14 (Pin 15) -> DI của MAX485 RIGHT
IO_PORT "right_tx" IO_TYPE=LVCMOS33;
IO_LOC "right_de" K14;         // GPIO15 (Pin 16) -> DE/RE_N của MAX485 RIGHT
IO_PORT "right_de" IO_TYPE=LVCMOS33;
