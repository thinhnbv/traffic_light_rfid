// =============================================================================
// Physical Constraints File for RFID Quick Test (.cst)
// Device: GW5A-LV25MG121 on Xiaomeige ACG525
// =============================================================================

// Clock & Reset
IO_LOC "clk_osc" T9;            // CLK_G 50MHz
IO_PORT "clk_osc" IO_TYPE=LVCMOS33;

IO_LOC "rst_btn_n" B16;         // KEY0
IO_PORT "rst_btn_n" IO_TYPE=LVCMOS33;

// Onboard LEDs
IO_LOC "led_onboard[0]" D14;    // LED0 onboard
IO_PORT "led_onboard[0]" IO_TYPE=LVCMOS33;
IO_LOC "led_onboard[1]" C14;    // LED1 onboard
IO_PORT "led_onboard[1]" IO_TYPE=LVCMOS33;
IO_LOC "led_onboard[2]" B9;     // LED2 onboard
IO_PORT "led_onboard[2]" IO_TYPE=LVCMOS33;
IO_LOC "led_onboard[3]" A9;     // LED3 onboard
IO_PORT "led_onboard[3]" IO_TYPE=LVCMOS33;

// SPI RC522 (Header 40-pin)
IO_LOC "spi_sck" G14;          // GPIO3 (Pin 4) -> SCK
IO_PORT "spi_sck" IO_TYPE=LVCMOS33;
IO_LOC "spi_mosi" D17;         // GPIO4 (Pin 5) -> MOSI
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33;
IO_LOC "spi_miso" D18;         // GPIO5 (Pin 6) -> MISO
IO_PORT "spi_miso" IO_TYPE=LVCMOS33;

IO_LOC "cs_n[3]" G16;          // GPIO6 (Pin 7) -> CS Reader North
IO_PORT "cs_n[3]" IO_TYPE=LVCMOS33;
IO_LOC "cs_n[2]" G18;          // GPIO7 (Pin 8) -> CS Reader South
IO_PORT "cs_n[2]" IO_TYPE=LVCMOS33;
IO_LOC "cs_n[1]" F17;          // GPIO8 (Pin 9) -> CS Reader East
IO_PORT "cs_n[1]" IO_TYPE=LVCMOS33;
IO_LOC "cs_n[0]" F18;          // GPIO9 (Pin 10) -> CS Reader West
IO_PORT "cs_n[0]" IO_TYPE=LVCMOS33;
